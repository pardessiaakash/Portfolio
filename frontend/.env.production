# Production settings. Values set in the hosting dashboard (Vercel / Netlify:
# Project settings -> Environment variables) take priority over these.

# The live address, no trailing slash, e.g. https://akashp.design
# Used for link-preview images and the sitemap.
REACT_APP_SITE_URL=

# Nova's AI runs as a serverless function on this same site (/api/nova);
# it needs ANTHROPIC_API_KEY set on the host, see nova/README.md.
# REACT_APP_NOVA_URL only if it lives somewhere else.
REACT_APP_NOVA_URL=

# Old Python backend (voice input only), e.g. https://api.akashp.design
REACT_APP_API_URL=

# LinkedIn profile, e.g. https://www.linkedin.com/in/your-name
REACT_APP_LINKEDIN_URL=https://www.linkedin.com/in/aakash-pardeshi-190222130/

# Resume PDF: leave empty to use public/Akash-P-Resume.pdf, or paste a link
# to a hosted copy. Until the PDF exists the button says "Request Resume".
REACT_APP_RESUME_URL=

# Optional booking link for "Let's talk" (e.g. Calendly). Empty = email.
REACT_APP_CONTACT_URL=

# Optional privacy-friendly analytics (Plausible): your site's domain,
# e.g. akashp.design. Empty = no analytics.
REACT_APP_PLAUSIBLE_DOMAIN=
